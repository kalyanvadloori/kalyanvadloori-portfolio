# Copy this file to `.env` and fill in the value. `.env` is gitignored.

# Web3Forms access key — makes the contact form deliver to your inbox instead of
# opening the visitor's mail client (which silently fails on machines with no
# mail app configured, losing you messages).
#
# Get one free in ~30 seconds, no account needed: https://web3forms.com
# Enter your email, they send you the key. Paste it below.
#
# When deploying: add this same variable in your host's dashboard
# (Vercel → Settings → Environment Variables, or Netlify → Site configuration).
VITE_WEB3FORMS_KEY=
